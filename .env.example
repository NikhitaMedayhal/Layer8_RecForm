# --- MongoDB (Atlas) ---
# Use the mongodb+srv:// connection string from Atlas — it negotiates TLS
# by default. Create a DB user with a strong, unique password (not your
# Atlas account password), and restrict IP access to Vercel's ranges or
# "allow from anywhere" only if you must (Atlas + auth is still required
# either way, but a tighter allowlist is safer).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="layer8"

# --- NextAuth (admin login) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Sheets live sync (optional but requested) ---
# 1. console.cloud.google.com -> create project -> enable "Google Sheets API"
# 2. Create a Service Account -> create a JSON key
# 3. Share your target Google Sheet with the service account's email as Editor
# 4. Fill these in from the JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Paste the private_key value from the JSON key, keeping \n escaped as literal \n:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID="your-google-sheet-id"
